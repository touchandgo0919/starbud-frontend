{
  "name": "starbud-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name starbud-frontend",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^12.8.2",
    "element-plus": "^2.14.3",
    "pinia": "^3.0.4",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.7",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "unocss": "^65.4.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}
